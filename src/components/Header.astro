---
import HeaderLink from './HeaderLink.astro';
import { sitePath } from '../utils/paths';
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <nav aria-label="Main navigation">
    <a class="wordmark" href={sitePath()}>jun hong<span aria-hidden="true">.</span></a>
    <div class="internal-links">
      <HeaderLink href={sitePath()}>Home</HeaderLink>
      <HeaderLink href={sitePath('blog/')}>Writing</HeaderLink>
      <HeaderLink href={sitePath('about/')}>About</HeaderLink>
    </div>
    <a class="contact-link" href="mailto:lewischua.junhong@gmail.com">Say hello ↗</a>
  </nav>
</header>
<style>
nav { max-width: 1100px; margin: auto; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
nav a { color: inherit; text-decoration: none; }
.wordmark { font-size: 1.4rem; font-weight: bold; letter-spacing: -.06em; }
.wordmark span { color: var(--accent); }
.internal-links { display: flex; gap: 1.5rem; font-size: .9rem; }
.contact-link { font-size: .85rem; }
.skip-link { position: absolute; top: -100px; left: 1rem; background: white; padding: .5rem; z-index: 10; }
.skip-link:focus { top: 0; }
@media(max-width: 500px) { .contact-link { display: none; } .internal-links { gap: 1rem; } }
</style>
