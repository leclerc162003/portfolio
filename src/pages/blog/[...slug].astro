---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id),
  );
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}
interface Props {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = Math.max(1, Math.ceil((post.body ?? '').split(/\s+/).filter(Boolean).length / 220));
---
<BlogPost {...post.data} headings={headings} readingMinutes={readingMinutes} newer={newer} older={older}>
  <Content />
</BlogPost>
