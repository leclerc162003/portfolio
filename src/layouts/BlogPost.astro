---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { sitePath } from '../utils/paths';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
  readingMinutes?: number;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
};
const { title, description, pubDate, updatedDate, heroImage, headings = [], readingMinutes = 1, newer, older } = Astro.props;
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} /></head>
  <body>
    <Header />
    <main id="main-content">
      <a class="back-link" href={sitePath('blog/')}><span aria-hidden="true">←</span> Back to the notebook</a>
      <article aria-labelledby="post-title">
        <header class="post-header">
          <p class="eyebrow">A page from the notebook / Jun Hong</p>
          <h1 id="post-title">{title}</h1>
          <p class="description">{description}</p>
          <div class="metadata"><FormattedDate date={pubDate} /><span aria-hidden="true">·</span><span>{readingMinutes} min read</span>{updatedDate && <span class="updated">Updated <FormattedDate date={updatedDate} /></span>}</div>
          <span class="stamp" aria-hidden="true">KEEP<br />EXPLORING ✳</span>
        </header>
        {heroImage && <figure class="hero-image"><Image width={1100} height={550} src={heroImage} alt="" /></figure>}
        <div class:list={['reading-layout', { 'has-contents': contents.length > 0 }]}>
          {contents.length > 0 && <aside class="contents"><nav aria-label="On this page"><p class="eyebrow">In this note</p><ol>{contents.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>}
          <div class="prose"><slot /></div>
        </div>
        <div class="endnote"><span aria-hidden="true">✳</span><p>One thought leads to another.<br /><a href={sitePath('blog/')}>Find your next little discovery.</a></p><a href="#post-title" class="top-link">Back to top ↑</a></div>
      </article>
      {(newer || older) && <nav class="post-navigation" aria-label="More notes">{newer && <a href={sitePath(`blog/${newer.id}/`)}><span class="eyebrow">← Newer note</span><h2>{newer.data.title}</h2><p>{newer.data.description}</p></a>}{older && <a href={sitePath(`blog/${older.id}/`)}><span class="eyebrow">Older note →</span><h2>{older.data.title}</h2><p>{older.data.description}</p></a>}</nav>}
    </main>
    <Footer />
  </body>
</html>
<style>
  main { width: 1100px; padding-block: 2rem 5rem; }
  .back-link { font-size: .85rem; text-decoration: none; display: inline-block; padding-block: .5rem; margin-bottom: 2rem; }
  .post-header { position: relative; padding: 2.5rem 8rem 2.5rem 2.5rem; background: #e9eddf; border: 1px solid #ccd3c2; border-radius: 3px 3px 0 0; }
  h1 { max-width: 850px; font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -.055em; line-height: 1.08; margin-block: 1rem; }
  .description { font-size: 1.2rem; max-width: 700px; margin-bottom: 1.5rem; }
  .metadata { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; font-size: .8rem; }.updated { flex-basis: 100%; }
  .stamp { position: absolute; right: 1.5rem; top: 2rem; border: 1px dashed var(--accent); border-radius: 50%; padding: 1rem .8rem; font: .65rem/1.5 monospace; text-align: center; transform: rotate(12deg); color: var(--accent); }
  .hero-image { margin: 0; }.hero-image img { display: block; width: 100%; aspect-ratio: 2; object-fit: cover; border-radius: 0 0 3px 3px; }
  .reading-layout { margin-block: 3rem; }.prose { width: 100%; max-width: 720px; margin-inline: auto; min-width: 0; }
  .has-contents { display: grid; grid-template-columns: 200px minmax(0, 720px); gap: 3rem; justify-content: center; }
  .contents nav { position: sticky; top: 2rem; max-height: calc(100vh - 4rem); overflow-y: auto; padding: .5rem; }
  .contents ol { list-style: none; padding: 0; margin: 1rem 0; border-left: 1px solid #cbd1c2; }.contents li { margin: .6rem 0; padding-left: 1rem; }.contents .nested { padding-left: 1.8rem; }
  .contents a { font-size: .8rem; line-height: 1.5; text-decoration: none; display: block; }
  .prose :global(h1), .prose :global(h2), .prose :global(h3), .prose :global(h4) { scroll-margin-top: 2rem; margin-top: 2.5rem; letter-spacing: -.025em; }
  .prose :global(h1) { font-size: 2.3rem; }.prose :global(h2) { font-size: 1.9rem; }.prose :global(h3) { font-size: 1.45rem; }
  .prose :global(p) { margin-block: 0 1.5rem; }.prose :global(li) { margin-bottom: .5rem; }
  .prose :global(a) { text-underline-offset: .2em; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; font-size: .85rem; }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: .9rem; }.prose :global(th), .prose :global(td) { border: 1px solid #cbd1c2; padding: .6rem .8rem; }
  .prose :global(blockquote) { padding: 1rem 1.5rem; background: #edf0e6; font: italic 1.2rem/1.7 Georgia, serif; margin-block: 1.5rem; }.prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .endnote { max-width: 720px; margin: 3rem auto; border-top: 1px dashed #aeb9a5; padding-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; font-size: .9rem; }.endnote > span { font-size: 2.5rem; color: var(--accent); }.endnote p { margin: 0; }.top-link { margin-left: auto; font-size: .8rem; }
  .post-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }.post-navigation > a { padding: 1.5rem; border: 1px solid #cbd1c2; background: #fffdf8; color: inherit; text-decoration: none; transition: background .2s; }.post-navigation > a:hover { background: #e9eddf; }.post-navigation h2 { font-size: 1.3rem; margin-top: 1rem; }.post-navigation p { font-size: .85rem; margin-bottom: 0; }
  @media(max-width: 900px) { .has-contents { grid-template-columns: minmax(0, 1fr); gap: 2rem; }.contents nav { position: static; max-height: none; padding: 1rem 1.2rem; border: 1px dashed #cbd1c2; }.contents ol { columns: 2; }.contents li { break-inside: avoid; } }
  @media(max-width: 540px) { .post-header { padding: 1.5rem; }.stamp { position: static; display: inline-block; margin-top: 1.5rem; }.description { font-size: 1.05rem; }.post-navigation { grid-template-columns: 1fr; }.contents ol { columns: 1; }.reading-layout { margin-block: 2rem; }.top-link { margin-left: 0; } }
</style>
